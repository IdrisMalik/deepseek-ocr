{
  "name": "deepseek-ocr-studio",
  "version": "0.1.0",
  "description": "A static, browser-only OCR workstation for the official DeepSeek OCR API (Public Beta).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type && vite build",
    "type": "tsc --noEmit",
    "lint": "oxlint src tests",
    "format": "oxfmt --write src tests",
    "format:check": "oxfmt --check src tests",
    "test": "tsx --test tests/*.test.ts",
    "test:ocr": "npm run test:ocr:validate && npm run test:ocr:eval",
    "test:ocr:validate": "python tests/ocr-eval/tools/validate.py",
    "test:ocr:eval": "tsx tests/ocr-eval/tools/eval.ts",
    "preview": "vite preview --host localhost --port 4173"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
